{
  "name": "dsh-seedream-studio",
  "version": "0.1.0",
  "description": "Seedream Studio — 豆包 Seedream 生图的图形工作台：侧边栏整页 UI + agent 工具，共用同一套生成实现。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "seedream",
    "doubao",
    "volcengine",
    "image-generation",
    "dsh",
    "deepseek-harness",
    "ark"
  ],
  "license": "MIT",
  "author": "TalentedPlayerXXC",
  "icon": "icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TalentedPlayerXXC/dsh-seedream-studio.git"
  },
  "homepage": "https://github.com/TalentedPlayerXXC/dsh-seedream-studio#readme",
  "bugs": {
    "url": "https://github.com/TalentedPlayerXXC/dsh-seedream-studio/issues"
  }
}
